<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".RecipeSuggestionsActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#F5F5F5">

        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recipe Suggestions"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3949AB"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewIngredientLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Enter Main Ingredient:"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#3949AB"
            app:layout_constraintTop_toBottomOf="@id/textViewTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/editTextIngredient"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:hint=""
            android:inputType="text"
            android:background="@android:drawable/edit_text"
            app:layout_constraintTop_toBottomOf="@id/textViewIngredientLabel"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <ImageView
            android:id="@+id/imageViewCooking"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="18dp"
            android:contentDescription="Cooking icon"
            android:src="@drawable/outline_cooking_24"
            app:layout_constraintTop_toBottomOf="@id/textViewIngredientLabel"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/layoutSearchArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toBottomOf="@id/editTextIngredient"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/buttonSearchRecipes"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="#FFFFFF"
                android:contentDescription="Search Recipes"
                android:src="@android:drawable/ic_menu_search"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/textViewSearchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Search\nRecipes"
                android:textAlignment="center"
                android:textColor="#3949AB"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textViewResultsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Recipe Results:"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3949AB"
            app:layout_constraintTop_toBottomOf="@id/imageViewCooking"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/textViewRecipe1Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Recipe 1:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5C6BC0"
            app:layout_constraintTop_toBottomOf="@id/textViewResultsHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/textViewRecipe2Label"
            app:layout_constraintHorizontal_bias="0.3" />

        <TextView
            android:id="@+id/textViewRecipe2Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Recipe 2:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#5C6BC0"
            app:layout_constraintTop_toBottomOf="@id/textViewResultsHeader"
            app:layout_constraintStart_toEndOf="@id/textViewRecipe1Label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.7" />

        <TextView
            android:id="@+id/textViewRecipe1"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Recipe 1 name"
            android:textColor="#283593"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/textViewRecipe1Label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/textViewRecipe2" />

        <TextView
            android:id="@+id/textViewRecipe2"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Recipe 2 name"
            android:textColor="#283593"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/textViewRecipe2Label"
            app:layout_constraintStart_toEndOf="@id/textViewRecipe1"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/layoutView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toBottomOf="@id/textViewRecipe1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layoutView2">

            <ImageButton
                android:id="@+id/buttonViewRecipe1"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="#FFFFFF"
                android:contentDescription="View Recipe 1"
                android:src="@drawable/outline_article_person_24"
                android:scaleType="centerInside" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="View Recipe"
                android:textColor="#3F51B5"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toBottomOf="@id/textViewRecipe2"
            app:layout_constraintStart_toEndOf="@id/layoutView1"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/buttonViewRecipe2"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="#FFFFFF"
                android:contentDescription="View Recipe 2"
                android:src="@drawable/outline_article_person_24"
                android:scaleType="centerInside" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="View Recipe"
                android:textColor="#3F51B5"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/layoutView1"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/imageHome"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Home"
                android:src="@drawable/outline_family_home_24" />

            <TextView
                android:id="@+id/textHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#3949AB"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>